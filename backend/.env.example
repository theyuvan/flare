# The only env var this backend needs.
# EVM private key for the relayer wallet — signs announce() and registerProof().
# It holds no user funds; fund it with Coston2 FLR from https://faucet.flare.network
RELAYER_PRIVATE_KEY=0x

# Optional — defaults to 4000.
# PORT=4000

# RPC URL and contract addresses are hardcoded constants at the top of index.js.
